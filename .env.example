POSTGRES_DB=vedu
POSTGRES_USER=vedu_app
POSTGRES_PASSWORD=change-this-local-database-password
JWT_SECRET=change-this-to-a-long-random-jwt-secret-at-least-32-characters
PASSWORD_RESET_DEMO_MODE=false
# Gmail: dùng smtp.gmail.com + mật khẩu ứng dụng, không dùng mật khẩu đăng nhập.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-personal-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Vedu LMS <your-personal-email@gmail.com>
VEDU_API_PORT=3000
VEDU_WEB_PORT=8080
ML_SERVICE_URL=http://127.0.0.1:8001
ML_INTERNAL_TOKEN=local-vedu-ml-change-me
MOMO_ENV=sandbox
# personal: upload receiving QR in Admin > Orders; no Business/API keys required.
# gateway: use the existing MoMo Business/Sandbox API integration below.
MOMO_PAYMENT_MODE=personal
# Shared team host: set to this server's private LAN/VPN IPv4 only.
VEDU_TEAM_BIND=127.0.0.1
VEDU_PUBLIC_URL=http://localhost:8080
VEDU_CORS_ORIGINS=http://localhost:8080
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# MoMo calls this server-to-server URL. localhost cannot receive external IPN.
MOMO_IPN_URL=
MOMO_REDIRECT_URL=
# Optional gateway integration; disabled means no request/cost to an outside AI service.
# Contract and privacy notes: docs/LEARNING_CONTENT_AND_PATHS.md
PATH_EXPLAIN_PROVIDER=disabled
PATH_EXPLAIN_URL=
PATH_EXPLAIN_API_KEY=
