{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vedu: Install dependencies",
      "type": "shell",
      "command": "npm ci; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Set-Location ../frontend; npm ci",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Vedu: Database (Docker)",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-dev-db.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Vedu: Backend",
      "type": "shell",
      "command": "npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+) - error TS(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting compilation in watch mode.*",
          "endsPattern": ".*Nest application successfully started.*"
        }
      }
    },
    {
      "label": "Vedu: Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "a^"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*http://localhost:5173.*"
        }
      }
    },
    {
      "label": "Vedu: Start development",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Vedu: Install dependencies",
        "Vedu: Database (Docker)",
        "Vedu: Backend",
        "Vedu: Frontend"
      ],
      "problemMatcher": []
    },
    {
      "label": "Vedu: Stop database",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml stop db",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
